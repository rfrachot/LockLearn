{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LockLearn source registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "provider", "homepage", "license_id", "status", "commercial_compatible"]
      }
    }
  }
}
