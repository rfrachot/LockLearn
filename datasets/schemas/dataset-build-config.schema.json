{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LockLearn dataset build configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id", "dataset_version", "built_at", "minimum_locklearn_version",
    "build_tool_version", "signing_key_id", "recipe", "sources"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "built_at": {"type": "string", "format": "date-time"},
    "minimum_locklearn_version": {"type": "string", "minLength": 1},
    "build_tool_version": {"type": "string", "minLength": 1},
    "signing_key_id": {"type": "string", "minLength": 1},
    "recipe": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
    "added_count": {"type": "integer", "minimum": 0},
    "changed_count": {"type": "integer", "minimum": 0},
    "removed_count": {"type": "integer", "minimum": 0},
    "required_free_disk": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "upstream_version", "retrieved_at", "files"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "upstream_version": {"type": "string", "minLength": 1},
          "upstream_date": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "snapshot_url": {"type": ["string", "null"]},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_url"],
              "properties": {
                "source_url": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "fetch_url": {"type": "string", "minLength": 1},
                "filename": {"type": "string", "minLength": 1},
                "maximum_bytes": {"type": "integer", "minimum": 1}
              },
              "oneOf": [
                {"required": ["path"], "not": {"required": ["fetch_url"]}},
                {"required": ["fetch_url"], "not": {"required": ["path"]}}
              ]
            }
          }
        }
      }
    }
  }
}
