# LockLearn P0 — Home Assistant development/test connection
#
# Copy this file to .env and fill in local values.
# NEVER commit .env or real Home Assistant credentials.
#
# Recommended: create a dedicated Home Assistant development user with admin
# rights for P0, then create a Long-Lived Access Token for that user.

# Base URL of the Home Assistant development instance.
# Examples:
#   http://127.0.0.1:8123
#   http://homeassistant.local:8123
#   https://ha-dev.example.test
LOCKLEARN_HA_URL=http://127.0.0.1:8123

# Long-Lived Access Token used by P0 test tooling for the HA REST/WebSocket APIs.
# Leave empty in the committed example.
LOCKLEARN_HA_ACCESS_TOKEN=

# TLS certificate verification for HTTPS connections.
# Keep true unless the development instance intentionally uses a self-signed
# certificate that cannot be trusted by the local system.
LOCKLEARN_HA_VERIFY_TLS=true

# Optional local path to the Home Assistant config directory.
# Useful when the dev agent runs on the same machine/VM and needs to install the
# custom component, inspect logs or validate generated frontend assets.
# Example: /home/renaud/ha-dev/config
LOCKLEARN_HA_CONFIG_DIR=

# Optional Home Assistant Device Registry IDs for real Companion App devices.
# P0 uses stable device_registry_id values rather than notify.* service names.
# These are test-only selectors; LockLearn runtime must resolve notify services
# dynamically from the Device Registry.
LOCKLEARN_HA_ANDROID_DEVICE_ID=
LOCKLEARN_HA_IOS_DEVICE_ID=

# Optional device used specifically to exercise the shared-device trust model.
# It may point to one of the devices above if that is the intended test setup.
LOCKLEARN_HA_SHARED_DEVICE_ID=
