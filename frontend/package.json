{
  "name": "locklearn-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:no-polling": "node scripts/check-no-polling.mjs",
    "docs:screenshot": "LOCKLEARN_DOCS_CAPTURE=1 playwright test e2e/tests/docs-screenshot.spec.ts"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1",
    "@playwright/test": "^1.55.0"
  }
}
